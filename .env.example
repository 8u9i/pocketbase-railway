# Copy to .env and adjust, or set these in the Railway dashboard.
# The entrypoint creates the admin superuser on first boot from these values.

# Admin superuser for the dashboard at /_/
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=changeme123

# Set to true to skip automatic superuser creation and use the installer link
# printed in the logs instead.
PB_SKIP_ADMIN=false

# Where PocketBase stores its SQLite database + uploads (must be on the volume).
PB_DATA_DIR=/pb/pb_data

# Port the HTTP server listens on. Railway injects PORT automatically.
PORT=8080

# Public URL of the app. Leave empty to auto-detect from RAILWAY_PUBLIC_DOMAIN
# (https://<your-app>.up.railway.app). Set explicitly when using a custom domain.
# Used for email links, OAuth2 redirects, file URLs, and the dashboard "App URL".
# PB_PUBLIC_URL=https://your-domain.com

# Optional: override the app name shown in the dashboard.
# PB_APP_NAME=My PocketBase

# Optional: enable transactional email (password resets, verification, OTP).
# PB_SMTP_HOST=smtp.example.com
# PB_SMTP_PORT=587
# PB_SMTP_USERNAME=apikey
# PB_SMTP_PASSWORD=secret
# PB_SMTP_TLS=true
# PB_SMTP_AUTH_METHOD=PLAIN
# PB_SMTP_LOCAL_NAME=

# Optional: scheduled backups (cron) - kept in the same database-backed settings.
# PB_BACKUPS_CRON=0 2 * * *
# PB_BACKUPS_CRON_MAX_KEEP=7

# Optional: encrypt PocketBase settings in the DB (32+ char random string).
# PB_ENCRYPTION_KEY=
